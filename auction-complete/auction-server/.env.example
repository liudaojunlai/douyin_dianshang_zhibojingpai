# ===========================
# 服务配置
# ===========================
APP_ENV=development
APP_PORT=8082
APP_SECRET=change-this-to-a-random-secret-key-32chars

# ===========================
# MySQL 配置
# ===========================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=auction
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# ===========================
# Redis 配置
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# JWT 配置
# ===========================
JWT_SECRET=change-this-jwt-secret-key
JWT_EXPIRE_HOURS=72

# ===========================
# WebSocket 配置
# ===========================
WS_HEARTBEAT_INTERVAL=15
WS_HEARTBEAT_TIMEOUT=30
