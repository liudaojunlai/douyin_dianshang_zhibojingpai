# ===========================
# 服务配置
# ===========================
APP_ENV=development        # development | production
APP_PORT=8080
APP_SECRET=change-this-to-a-random-secret-key-32chars

# ===========================
# MySQL 配置
# ===========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=auction_db
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# ===========================
# Redis 配置
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# JWT 配置
# ===========================
JWT_SECRET=change-this-jwt-secret-key
JWT_EXPIRE_HOURS=72

# ===========================
# WebSocket 配置
# ===========================
WS_HEARTBEAT_INTERVAL=15   # 心跳间隔（秒）
WS_HEARTBEAT_TIMEOUT=30    # 心跳超时（秒）
